# AI Urban Farming Assistant - Environment Variables
# Copy to .env and adjust as needed.

# ---------------------------------------------------------------- Backend
DATABASE_URL=sqlite:///./ai_farming.db
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# Trained model produced by: python -m ml.train
AI_MODEL_PATH=./ml/model/plant_disease_model.pth
AI_MODEL_DIR=./ml/model
AI_CONFIDENCE_THRESHOLD=0.60

# Dataset + training (see ML_SETUP.md)
AI_DATASET_DIR=./ml/data/plantvillage/color
AI_MIN_SAMPLES_PER_CLASS=10
AI_REQUIRE_ALL_CLASSES=true
AI_NEAR_DUP_THRESHOLD=0
AI_EPOCHS=20
AI_BATCH_SIZE=32
AI_LEARNING_RATE=0.0001
AI_MAX_UPLOAD_MB=10

# Plant-image gatekeeper (CLIP zero-shot). Set AI_ENABLE_CLIP=false to skip the
# download and use the built-in colour heuristic instead.
AI_ENABLE_CLIP=true
AI_CLIP_MODEL=openai/clip-vit-base-patch32

# Optional weather location for watering recommendations (Open-Meteo, no key).
WEATHER_LAT=
WEATHER_LON=

# --------------------------------------------------------------- Frontend
# Leave blank to use the Vite dev proxy (/api -> http://localhost:8000).
VITE_API_URL=
